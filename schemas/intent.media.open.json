{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nestorhome.dev/schemas/satellite/1/intent.media.open.json",
  "title": "A person opened a session: offer it at once (`POST /satellites/{device_id}/media`), the camera's video when",
  "x-protocol": "nestor.satellite/1",
  "x-direction": "to_satellite",
  "type": "object",
  "properties": {
    "type": {
      "const": "intent.media.open"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "video": {
          "type": "boolean"
        },
        "audio": {
          "type": "boolean"
        },
        "max_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "session",
        "video",
        "audio",
        "max_s"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "id",
    "at",
    "payload"
  ],
  "additionalProperties": false
}
